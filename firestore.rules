rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.size() == 10 && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'mehmet.azmir@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidUserPreferences(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'preferredMode',
          'preferredGeminiModel',
          'preferredLocalRuntime',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'photoUrl',
          'preferredMode',
          'preferredGeminiModel',
          'preferredLocalRuntime',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && (!data.keys().hasAny(['photoUrl']) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && data.preferredMode is string
        && data.preferredMode in ['local', 'gemini']
        && data.preferredGeminiModel is string
        && data.preferredGeminiModel in ['gemini-3.1-flash-lite']
        && data.preferredLocalRuntime is string
        && data.preferredLocalRuntime.size() >= 1
        && data.preferredLocalRuntime.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyQuota(data, userId, dateKey) {
      return data.keys().hasAll([
          'uid',
          'dateKey',
          'usedCount',
          'dailyLimit',
          'lastModel',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'dateKey',
          'usedCount',
          'dailyLimit',
          'lastModel',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.dateKey is string
        && data.dateKey == dateKey
        && isValidDateKey(data.dateKey)
        && data.usedCount is int
        && data.usedCount >= 0
        && data.usedCount <= 25
        && data.dailyLimit is int
        && data.dailyLimit == 25
        && data.usedCount <= data.dailyLimit
        && data.lastModel is string
        && data.lastModel.size() >= 1
        && data.lastModel.size() <= 64
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, userId) {
      return data.keys().hasAll([
          'uid',
          'role',
          'content',
          'engineLabel',
          'modelId',
          'pageContext',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'role',
          'content',
          'engineLabel',
          'modelId',
          'suggestedCss',
          'pageContext',
          'createdAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.role is string
        && data.role in ['user', 'assistant']
        && data.content is string
        && data.content.size() >= 1
        && data.content.size() <= 12000
        && data.engineLabel is string
        && data.engineLabel.size() >= 1
        && data.engineLabel.size() <= 100
        && data.modelId is string
        && data.modelId.size() >= 1
        && data.modelId.size() <= 64
        && (!data.keys().hasAny(['suggestedCss']) || (data.suggestedCss is string && data.suggestedCss.size() <= 6000))
        && data.pageContext is string
        && data.pageContext.size() >= 1
        && data.pageContext.size() <= 32
        && data.createdAt is timestamp;
    }

    function isValidUserNote(data, userId) {
      return data.keys().hasAll([
          'uid',
          'title',
          'content',
          'tag',
          'pinned',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'title',
          'content',
          'tag',
          'pinned',
          'templateHint',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 160
        && data.content is string
        && data.content.size() <= 50000
        && data.tag is string
        && data.tag in ['umum', 'xml', 'css', 'url', 'ide']
        && data.pinned is bool
        && (!data.keys().hasAny(['templateHint']) || (data.templateHint is string && data.templateHint.size() <= 120))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSiteAdsenseConfig(data) {
      return data.keys().hasAll([
          'adsenseEnabled',
          'publisherId',
          'autoAdsEnabled',
          'headMetaEnabled',
          'adsTxtContent',
          'hideAdsForAdmin',
          'hideAdsInOfflineMode',
          'testMode',
          'defaultTemplatePubId',
          'topBannerEnabled',
          'topBannerSlot',
          'topBannerFormat',
          'sidebarSlotEnabled',
          'sidebarSlotId',
          'sidebarSlotFormat',
          'footerSlotEnabled',
          'footerSlotId',
          'footerSlotFormat',
          'modalSlotEnabled',
          'modalSlotId',
          'modalSlotFormat',
          'adminNote',
          'updatedByUid',
          'updatedByEmail',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'adsenseEnabled',
          'publisherId',
          'autoAdsEnabled',
          'headMetaEnabled',
          'adsTxtContent',
          'hideAdsForAdmin',
          'hideAdsInOfflineMode',
          'testMode',
          'defaultTemplatePubId',
          'topBannerEnabled',
          'topBannerSlot',
          'topBannerFormat',
          'sidebarSlotEnabled',
          'sidebarSlotId',
          'sidebarSlotFormat',
          'footerSlotEnabled',
          'footerSlotId',
          'footerSlotFormat',
          'modalSlotEnabled',
          'modalSlotId',
          'modalSlotFormat',
          'adminNote',
          'updatedByUid',
          'updatedByEmail',
          'updatedAt'
        ])
        && data.adsenseEnabled is bool
        && data.publisherId is string
        && data.publisherId.size() <= 40
        && (data.publisherId == '' || data.publisherId.matches('^ca-pub-[0-9]{10,20}$'))
        && data.autoAdsEnabled is bool
        && data.headMetaEnabled is bool
        && data.adsTxtContent is string
        && data.adsTxtContent.size() <= 4000
        && data.hideAdsForAdmin is bool
        && data.hideAdsInOfflineMode is bool
        && data.testMode is bool
        && data.defaultTemplatePubId is string
        && data.defaultTemplatePubId.size() <= 40
        && (data.defaultTemplatePubId == '' || data.defaultTemplatePubId.matches('^ca-pub-[0-9]{10,20}$'))
        && data.topBannerEnabled is bool
        && data.topBannerSlot is string
        && data.topBannerSlot.size() <= 32
        && data.topBannerSlot.matches('^[0-9]*$')
        && data.topBannerFormat is string
        && data.topBannerFormat in ['auto', 'horizontal', 'rectangle']
        && data.sidebarSlotEnabled is bool
        && data.sidebarSlotId is string
        && data.sidebarSlotId.size() <= 32
        && data.sidebarSlotId.matches('^[0-9]*$')
        && data.sidebarSlotFormat is string
        && data.sidebarSlotFormat in ['auto', 'vertical', 'rectangle']
        && data.footerSlotEnabled is bool
        && data.footerSlotId is string
        && data.footerSlotId.size() <= 32
        && data.footerSlotId.matches('^[0-9]*$')
        && data.footerSlotFormat is string
        && data.footerSlotFormat in ['auto', 'horizontal', 'rectangle']
        && data.modalSlotEnabled is bool
        && data.modalSlotId is string
        && data.modalSlotId.size() <= 32
        && data.modalSlotId.matches('^[0-9]*$')
        && data.modalSlotFormat is string
        && data.modalSlotFormat in ['auto', 'rectangle']
        && data.adminNote is string
        && data.adminNote.size() <= 500
        && data.updatedByUid is string
        && data.updatedByUid == request.auth.uid
        && isValidId(data.updatedByUid)
        && data.updatedByEmail is string
        && data.updatedByEmail.size() >= 3
        && data.updatedByEmail.size() <= 160
        && data.updatedAt is timestamp;
    }

    function isValidAdsenseUnit(data) {
      return data.keys().hasAll([
          'name',
          'slotId',
          'format',
          'placement',
          'enabled',
          'onlyOnPosts',
          'notes',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'name',
          'slotId',
          'format',
          'placement',
          'enabled',
          'onlyOnPosts',
          'notes',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.slotId is string
        && data.slotId.size() <= 32
        && data.slotId.matches('^[0-9]*$')
        && data.format is string
        && data.format in ['responsive', 'leaderboard', 'sidebar', 'in-article', 'multiplex']
        && data.placement is string
        && data.placement in ['topBanner', 'sidebarSlot', 'footerSlot', 'modalSlot', 'bloggerTemplate']
        && data.enabled is bool
        && data.onlyOnPosts is bool
        && data.notes is string
        && data.notes.size() <= 300
        && data.createdByUid is string
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data, adminUid) {
      return data.keys().hasAll([
          'uid',
          'email',
          'label',
          'addedByUid',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'label',
          'addedByUid',
          'createdAt'
        ])
        && data.uid is string
        && data.uid == adminUid
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.label is string
        && data.label.size() <= 80
        && data.addedByUid is string
        && data.addedByUid == request.auth.uid
        && isValidId(data.addedByUid)
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserPreferences(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserPreferences(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'photoUrl',
          'preferredMode',
          'preferredGeminiModel',
          'preferredLocalRuntime',
          'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId);

      match /quotas/{dateKey} {
        allow get: if isValidDateKey(dateKey) && isOwner(userId);
        allow list: if false;
        allow create: if isValidDateKey(dateKey)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidDailyQuota(incoming(), userId, dateKey)
          && incoming().updatedAt == request.time;
        allow update: if isValidDateKey(dateKey)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidDailyQuota(incoming(), userId, dateKey)
          && incoming().uid == existing().uid
          && incoming().dateKey == existing().dateKey
          && incoming().dailyLimit == existing().dailyLimit
          && incoming().usedCount >= existing().usedCount
          && incoming().usedCount <= existing().usedCount + 1
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'usedCount',
            'lastModel',
            'updatedAt'
          ]);
        allow delete: if false;
      }

      match /chatMessages/{messageId} {
        allow get: if isValidId(messageId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(messageId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidChatMessage(incoming(), userId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(messageId) && isOwner(userId);
      }

      match /notes/{noteId} {
        allow get: if isValidId(noteId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(noteId)
          && isOwner(userId)
          && isValidUserNote(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(noteId)
          && isOwner(userId)
          && isValidUserNote(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'content',
            'tag',
            'pinned',
            'templateHint',
            'updatedAt'
          ])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(noteId) && isOwner(userId);
      }
    }

    match /appConfig/{configId} {
      allow get: if configId == 'adsense';
      allow list: if false;
      allow create: if configId == 'adsense'
        && isAdmin()
        && isValidSiteAdsenseConfig(incoming())
        && incoming().updatedAt == request.time;
      allow update: if configId == 'adsense'
        && isAdmin()
        && isValidSiteAdsenseConfig(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'adsenseEnabled',
          'publisherId',
          'autoAdsEnabled',
          'headMetaEnabled',
          'adsTxtContent',
          'hideAdsForAdmin',
          'hideAdsInOfflineMode',
          'testMode',
          'defaultTemplatePubId',
          'topBannerEnabled',
          'topBannerSlot',
          'topBannerFormat',
          'sidebarSlotEnabled',
          'sidebarSlotId',
          'sidebarSlotFormat',
          'footerSlotEnabled',
          'footerSlotId',
          'footerSlotFormat',
          'modalSlotEnabled',
          'modalSlotId',
          'modalSlotFormat',
          'adminNote',
          'updatedByUid',
          'updatedByEmail',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /adsenseUnits/{unitId} {
      allow get: if isValidId(unitId) && (existing().enabled == true || isAdmin());
      allow list: if isBootstrappedAdmin() || resource.data.enabled == true;
      allow create: if isValidId(unitId)
        && isAdmin()
        && isValidAdsenseUnit(incoming())
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(unitId)
        && isAdmin()
        && isValidAdsenseUnit(incoming())
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'slotId',
          'format',
          'placement',
          'enabled',
          'onlyOnPosts',
          'notes',
          'updatedAt'
        ]);
      allow delete: if isValidId(unitId) && isAdmin();
    }

    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(adminUid)
        && isBootstrappedAdmin()
        && isValidAdminUser(incoming(), adminUid)
        && incoming().createdAt == request.time;
      allow update: if isValidId(adminUid)
        && isBootstrappedAdmin()
        && isValidAdminUser(incoming(), adminUid)
        && incoming().uid == existing().uid
        && incoming().addedByUid == existing().addedByUid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'label']);
      allow delete: if isValidId(adminUid) && isBootstrappedAdmin();
    }
  }
}
